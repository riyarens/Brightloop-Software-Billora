// ==============================================================================
// BILLORA - Subscription Management System for Brightloop Software
// Database Architecture: PostgreSQL 16+
// Technical Lead: Member 1 - Riya
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
  DIGITAL
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum SubscriptionEventType {
  CREATED
  CONFIRMED
  ACTIVATED
  PAUSED
  RESUMED
  RENEWED
  CLOSED
  MODIFIED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  SENT
  PAID
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  UPI
  CASH
  STRIPE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  BILLING
  SUBSCRIPTION
}

enum RevenueAlertType {
  OVERDUE_INVOICE
  PAYMENT_FAILURE
  EXPIRING_SUBSCRIPTION
  REVENUE_LEAKAGE
  HIGH_CHURN_RISK
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ------------------------------------------------------------------------------
// 1. USER
// ------------------------------------------------------------------------------
model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  password              String
  firstName             String?
  lastName              String?
  role                  Role                @default(CUSTOMER)
  isActive              Boolean             @default(true)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  customer              Customer?
  subscriptionEvents    SubscriptionEvent[]
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@index([email])
  @@index([role])
}

// ------------------------------------------------------------------------------
// 2. CUSTOMER
// ------------------------------------------------------------------------------
model Customer {
  id                    String              @id @default(uuid())
  userId                String?             @unique
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  email                 String              @unique
  phone                 String?
  company               String?
  address               String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?             @default("India")
  taxId                 String?             // GST / VAT / Tax Identification Number
  notes                 String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  subscriptions         Subscription[]
  quotations            Quotation[]
  invoices              Invoice[]

  @@index([email])
  @@index([name])
}

// ------------------------------------------------------------------------------
// 3. PRODUCT
// ------------------------------------------------------------------------------
model Product {
  id                    String              @id @default(uuid())
  name                  String
  code                  String?             @unique
  description           String?
  type                  ProductType         @default(SERVICE)
  salesPrice            Decimal             @db.Decimal(12, 2)
  costPrice             Decimal             @default(0) @db.Decimal(12, 2)
  notes                 String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  variants              Variant[]
  planProducts          PlanProduct[]
  subscriptionLines     SubscriptionLine[]
  quotationLines        QuotationLine[]
  invoiceLines          InvoiceLine[]

  @@index([name])
}

// ------------------------------------------------------------------------------
// 4. VARIANT
// Supports brand-level variant configurations, including Odoo brand extra price (+560)
// ------------------------------------------------------------------------------
model Variant {
  id                    String              @id @default(uuid())
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand                 String              // e.g., "Odoo", "Brightloop", etc.
  name                  String?             // Optional variant label
  extraPrice            Decimal             @default(0) @db.Decimal(12, 2) // Supports +560 for Odoo brand
  sku                   String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  subscriptionLines     SubscriptionLine[]
  quotationLines        QuotationLine[]
  invoiceLines          InvoiceLine[]

  @@index([productId])
  @@index([brand])
}

// ------------------------------------------------------------------------------
// 5. PLAN
// ------------------------------------------------------------------------------
model Plan {
  id                    String              @id @default(uuid())
  name                  String
  code                  String?             @unique
  description           String?
  billingPeriod         BillingPeriod       @default(MONTHLY)
  billingInterval       Int                 @default(1)
  price                 Decimal             @default(0) @db.Decimal(12, 2)
  minQuantity           Int                 @default(1)
  startDate             DateTime?
  endDate               DateTime?
  autoClose             Boolean             @default(false)
  allowPause            Boolean             @default(true)
  maxPauseDurationDays  Int?
  allowRenew            Boolean             @default(true)
  allowEarlyClose       Boolean             @default(true)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  planProducts          PlanProduct[]
  subscriptions         Subscription[]
  quotationTemplates    QuotationTemplate[]
  quotations            Quotation[]

  @@index([billingPeriod])
  @@index([isActive])
}

// ------------------------------------------------------------------------------
// 6. PLAN PRODUCT (Join table for plan components)
// ------------------------------------------------------------------------------
model PlanProduct {
  id                    String              @id @default(uuid())
  planId                String
  plan                  Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  defaultQuantity       Int                 @default(1)
  isMandatory           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([planId, productId])
  @@index([planId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// 7. TAX
// ------------------------------------------------------------------------------
model Tax {
  id                    String              @id @default(uuid())
  name                  String
  rate                  Decimal             @db.Decimal(5, 2) // e.g. 18.00 for 18%
  type                  TaxType             @default(PERCENTAGE)
  isIncludedInPrice     Boolean             @default(false)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  subscriptionLines     SubscriptionLine[]
  quotationLines        QuotationLine[]
  invoiceLines          InvoiceLine[]
}

// ------------------------------------------------------------------------------
// 8. DISCOUNT
// ------------------------------------------------------------------------------
model Discount {
  id                    String              @id @default(uuid())
  name                  String
  code                  String?             @unique
  type                  DiscountType        @default(PERCENTAGE)
  value                 Decimal             @db.Decimal(12, 2)
  startDate             DateTime?
  endDate               DateTime?
  minOrderAmount        Decimal?            @db.Decimal(12, 2)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  subscriptionLines     SubscriptionLine[]
  quotationLines        QuotationLine[]
  invoiceLines          InvoiceLine[]

  @@index([code])
}

// ------------------------------------------------------------------------------
// 9. QUOTATION TEMPLATE
// ------------------------------------------------------------------------------
model QuotationTemplate {
  id                    String              @id @default(uuid())
  name                  String
  description           String?
  planId                String?
  plan                  Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  defaultDurationDays   Int?                @default(30)
  termsAndConditions    String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  quotations            Quotation[]

  @@index([planId])
}

// ------------------------------------------------------------------------------
// 10. QUOTATION
// ------------------------------------------------------------------------------
model Quotation {
  id                    String              @id @default(uuid())
  quotationNumber       String              @unique
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId                String?
  plan                  Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  templateId            String?
  template              QuotationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status                QuotationStatus     @default(DRAFT)
  validUntil            DateTime?
  subtotal              Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @default(0) @db.Decimal(12, 2)
  termsAndConditions    String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  lines                 QuotationLine[]
  subscriptions         Subscription[]

  @@index([customerId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 11. QUOTATION LINE
// ------------------------------------------------------------------------------
model QuotationLine {
  id                    String              @id @default(uuid())
  quotationId           String
  quotation             Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId             String?
  variant               Variant?            @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description           String?
  quantity              Int                 @default(1)
  unitPrice             Decimal             @db.Decimal(12, 2)
  taxId                 String?
  tax                   Tax?                @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxRate               Decimal             @default(0) @db.Decimal(5, 2)
  discountId            String?
  discount              Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountAmount        Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @db.Decimal(12, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([quotationId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// 12. SUBSCRIPTION
// ------------------------------------------------------------------------------
model Subscription {
  id                    String              @id @default(uuid())
  subscriptionNumber    String              @unique // e.g., SUB-0001
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId                String
  plan                  Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotationId           String?
  quotation             Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status                SubscriptionStatus  @default(DRAFT)
  isPaused              Boolean             @default(false)
  pausedAt              DateTime?
  pauseCount            Int                 @default(0)
  startDate             DateTime
  expiryDate            DateTime?
  nextBillingDate       DateTime?
  lastBillingDate       DateTime?
  paymentTerms          String              @default("Immediate Payment")
  autoRenew             Boolean             @default(true)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  lines                 SubscriptionLine[]
  events                SubscriptionEvent[]
  invoices              Invoice[]
  revenueAlerts         RevenueAlert[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
}

// ------------------------------------------------------------------------------
// 13. SUBSCRIPTION LINE
// ------------------------------------------------------------------------------
model SubscriptionLine {
  id                    String              @id @default(uuid())
  subscriptionId        String
  subscription          Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId             String?
  variant               Variant?            @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description           String?
  quantity              Int                 @default(1)
  unitPrice             Decimal             @db.Decimal(12, 2)
  taxId                 String?
  tax                   Tax?                @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxRate               Decimal             @default(0) @db.Decimal(5, 2)
  discountId            String?
  discount              Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountAmount        Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @db.Decimal(12, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([subscriptionId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// 14. SUBSCRIPTION EVENT
// ------------------------------------------------------------------------------
model SubscriptionEvent {
  id                    String                @id @default(uuid())
  subscriptionId        String
  subscription          Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousStatus        SubscriptionStatus?
  newStatus             SubscriptionStatus
  eventType             SubscriptionEventType
  note                  String?
  userId                String?
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  timestamp             DateTime              @default(now())

  @@index([subscriptionId])
  @@index([timestamp])
  @@index([eventType])
}

// ------------------------------------------------------------------------------
// 15. INVOICE
// Idempotency: @@unique([subscriptionId, billingPeriodStart]) prevents duplicate billing
// ------------------------------------------------------------------------------
model Invoice {
  id                    String              @id @default(uuid())
  invoiceNumber         String              @unique // e.g., INV-0001
  subscriptionId        String
  subscription          Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  invoiceDate           DateTime            @default(now())
  dueDate               DateTime
  subtotal              Decimal             @db.Decimal(12, 2)
  taxAmount             Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @db.Decimal(12, 2)
  amountPaid            Decimal             @default(0) @db.Decimal(12, 2)
  status                InvoiceStatus       @default(DRAFT)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  lines                 InvoiceLine[]
  payments              Payment[]
  revenueAlerts         RevenueAlert[]

  // CRITICAL IDEMPOTENCY CONSTRAINT
  @@unique([subscriptionId, billingPeriodStart])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceDate])
}

// ------------------------------------------------------------------------------
// 16. INVOICE LINE
// ------------------------------------------------------------------------------
model InvoiceLine {
  id                    String              @id @default(uuid())
  invoiceId             String
  invoice               Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId             String?
  variant               Variant?            @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description           String?
  quantity              Int                 @default(1)
  unitPrice             Decimal             @db.Decimal(12, 2)
  taxId                 String?
  tax                   Tax?                @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxRate               Decimal             @default(0) @db.Decimal(5, 2)
  discountId            String?
  discount              Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountAmount        Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @db.Decimal(12, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// 17. PAYMENT
// ------------------------------------------------------------------------------
model Payment {
  id                    String              @id @default(uuid())
  paymentNumber         String              @unique // e.g., PAY-0001
  invoiceId             String
  invoice               Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentMethod         PaymentMethod
  amount                Decimal             @db.Decimal(12, 2)
  paymentDate           DateTime            @default(now())
  transactionReference  String?
  status                PaymentStatus       @default(SUCCESS)
  note                  String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([paymentDate])
  @@index([invoiceId])
}

// ------------------------------------------------------------------------------
// 18. AUDIT LOG
// ------------------------------------------------------------------------------
model AuditLog {
  id                    String              @id @default(uuid())
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  action                String
  entityType            String
  entityId              String?
  oldValues             Json?
  newValues             Json?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 19. NOTIFICATION
// ------------------------------------------------------------------------------
model Notification {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  message               String
  type                  NotificationType    @default(INFO)
  isRead                Boolean             @default(false)
  link                  String?
  createdAt             DateTime            @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 20. REVENUE ALERT
// Supports Member 3's revenue leakage tracking and overdue detection
// ------------------------------------------------------------------------------
model RevenueAlert {
  id                    String              @id @default(uuid())
  alertType             RevenueAlertType
  severity              AlertSeverity       @default(MEDIUM)
  title                 String
  description           String
  subscriptionId        String?
  subscription          Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceId             String?
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  isResolved            Boolean             @default(false)
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([alertType, isResolved])
  @@index([createdAt])
}

