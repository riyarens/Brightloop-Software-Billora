# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billora_db?schema=public"

# Authentication & Security
JWT_SECRET="your_jwt_super_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Email Configuration (Nodemailer / Mailtrap)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_mailtrap_user"
SMTP_PASS="your_mailtrap_password"
EMAIL_FROM="BILLORA <noreply@brightloop.com>"

